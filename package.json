{
  "name": "youtube-tuner",
  "version": "0.9.0-beta.6",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/content.js src/background.js src/options.js src/popup.js --bundle --format=iife --outdir=dist --target=chrome120",
    "icons": "node tools/make-icons.mjs",
    "package": "npm run build && node tools/package.mjs",
    "crx": "npm run package && node tools/crx.mjs",
    "test": "node --test --test-isolation=none test/*.test.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0"
  }
}
